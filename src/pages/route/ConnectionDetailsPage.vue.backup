<template>
  <PageLayout
    :title="pageTitle"
    :subtitle="pageSubtitle"
    icon="cable"
  >
    <!-- 面包屑 -->
    <template #breadcrumbs>
      <q-breadcrumbs>
        <q-breadcrumbs-el label="活跃路由" to="/app/routes/active" icon="route" />
        <q-breadcrumbs-el 
          :label="sourceNodeInfo?.node_name || '节点'"
          :to="`/app/routes/active/${nodeId}`"
        />
        <q-breadcrumbs-el 
          :label="peerNodeInfo?.node_name || '对端节点'"
        />
      </q-breadcrumbs>
    </template>

    <template #actions>
      <q-btn
        flat
        icon="arrow_back"
        label="返回"
        @click="handleBack"
      />
      <q-btn
        color="primary"
        icon="sync"
        label="刷新"
        @click="loadConnectionDetails"
        :loading="loading"
      />
    </template>

    <!-- 加载中 -->
    <div v-if="loading && !connectionDetails.node_id" class="column items-center q-py-xl">
      <q-spinner color="primary" size="3em" />
      <div class="text-subtitle1 q-mt-md text-grey-6">加载连接详情...</div>
    </div>

    <!-- 内容区 -->
    <div v-else class="q-gutter-lg">
      <!-- 连接概览卡片 -->
      <div class="row q-col-gutter-md q-mb-lg">
        <!-- 本节点信息 -->
        <div class="col-12 col-md-6">
          <q-card>
            <q-card-section>
              <div class="row items-center q-mb-md">
                <q-icon name="router" color="primary" size="md" class="q-mr-sm" />
                <div class="text-h6">本节点</div>
              </div>
              <div v-if="sourceNodeInfo" class="q-gutter-y-md">
                <!-- 基本信息 -->
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">节点名称</div>
                  <div class="text-subtitle1 text-weight-medium">{{ sourceNodeInfo.node_name }}</div>
                </div>
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">节点ID</div>
                  <div class="text-body2">{{ sourceNodeInfo.node_id }}</div>
                </div>
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">所属用户</div>
                  <div class="text-body2">{{ sourceNodeInfo.user_name || '当前用户' }}</div>
                </div>
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">节点状态</div>
                  <q-chip
                    :color="getStatusColor(sourceNodeInfo.node_status)"
                    text-color="white"
                    size="sm"
                  >
                    {{ getStatusText(sourceNodeInfo.node_status) }}
                  </q-chip>
                </div>
                
                <!-- 设备信息 -->
                <div v-if="sourceDeviceInfo" class="q-mt-md q-pt-md border-top">
                  <div class="text-caption text-weight-medium text-grey-7 q-mb-sm">设备信息</div>
                  <div class="row q-col-gutter-sm">
                    <div class="col-12" v-if="sourceDeviceInfo.cpu_model">
                      <div class="text-caption text-grey-6">CPU</div>
                      <div class="text-body2">
                        {{ sourceDeviceInfo.cpu_model }}
                        <span v-if="sourceDeviceInfo.cpu_cores" class="text-grey-6">
                          ({{ sourceDeviceInfo.cpu_cores }}核{{ sourceDeviceInfo.cpu_threads ? `/${sourceDeviceInfo.cpu_threads}线程` : '' }})
                        </span>
                      </div>
                    </div>
                    <div class="col-12" v-if="sourceDeviceInfo.memory_total_mb">
                      <div class="text-caption text-grey-6">内存</div>
                      <div class="text-body2">
                        {{ formatMemory(sourceDeviceInfo.memory_total_mb) }}
                        <span v-if="sourceDeviceInfo.memory_free_mb" class="text-grey-6">
                          (可用 {{ formatMemory(sourceDeviceInfo.memory_free_mb) }})
                        </span>
                      </div>
                    </div>
                    <div class="col-12" v-if="sourceDeviceInfo.os_name">
                      <div class="text-caption text-grey-6">操作系统</div>
                      <div class="text-body2">
                        {{ sourceDeviceInfo.os_name }} {{ sourceDeviceInfo.os_version || '' }}
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- IP地址信息 -->
                <div v-if="sourceNodeInfo.network_config" class="q-mt-md q-pt-md border-top">
                  <div class="text-caption text-weight-medium text-grey-7 q-mb-sm">IP地址</div>
                  
                  <!-- 虚拟IP -->
                  <div v-if="sourceNodeInfo.network_config.node_ip" class="q-mb-xs">
                    <div class="text-caption text-grey-6">虚拟IP</div>
                    <div class="text-body2">
                      <q-chip size="sm" color="primary" text-color="white" dense>
                        {{ sourceNodeInfo.network_config.node_ip }}
                      </q-chip>
                    </div>
                  </div>
                  
                  <!-- 公网IP -->
                  <div v-if="getPublicIPs(sourceNodeInfo.network_config).length > 0" class="q-mb-xs">
                    <div class="text-caption text-grey-6">公网IP</div>
                    <div class="q-gutter-xs">
                      <q-chip
                        v-for="ip in getPublicIPs(sourceNodeInfo.network_config)"
                        :key="ip"
                        size="sm"
                        :color="isIPv6(ip) ? 'purple' : 'green'"
                        text-color="white"
                        dense
                      >
                        {{ ip }}
                        <q-tooltip>{{ isIPv6(ip) ? 'IPv6' : 'IPv4' }}</q-tooltip>
                      </q-chip>
                    </div>
                  </div>
                  
                  <!-- 局域网IP -->
                  <div v-if="sourceNodeInfo.network_config.lan_ips?.length > 0" class="q-mb-xs">
                    <div class="text-caption text-grey-6">局域网IP</div>
                    <div class="q-gutter-xs">
                      <q-chip
                        v-for="ip in sourceNodeInfo.network_config.lan_ips"
                        :key="ip"
                        size="sm"
                        color="orange"
                        text-color="white"
                        dense
                      >
                        {{ ip }}
                      </q-chip>
                    </div>
                  </div>
                </div>
              </div>
              <div v-else class="text-grey-6">加载中...</div>
            </q-card-section>
          </q-card>
        </div>
        
        <!-- 对端节点信息 -->
        <div class="col-12 col-md-6">
          <q-card>
            <q-card-section>
              <div class="row items-center q-mb-md">
                <q-icon name="router" color="secondary" size="md" class="q-mr-sm" />
                <div class="text-h6">对端节点</div>
              </div>
              <div v-if="peerNodeInfo" class="q-gutter-y-md">
                <!-- 基本信息 -->
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">节点名称</div>
                  <div class="text-subtitle1 text-weight-medium">{{ peerNodeInfo.node_name }}</div>
                </div>
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">节点ID</div>
                  <div class="text-body2">{{ peerNodeInfo.node_id }}</div>
                </div>
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">所属用户</div>
                  <div class="text-body2">{{ peerNodeInfo.user_name || '未知' }}</div>
                </div>
                <div class="q-mb-sm">
                  <div class="text-caption text-grey-6">节点状态</div>
                  <q-chip
                    :color="getStatusColor(peerNodeInfo.node_status)"
                    text-color="white"
                    size="sm"
                  >
                    {{ getStatusText(peerNodeInfo.node_status) }}
                  </q-chip>
                </div>
                
                <!-- 设备信息 -->
                <div v-if="peerDeviceInfo" class="q-mt-md q-pt-md border-top">
                  <div class="text-caption text-weight-medium text-grey-7 q-mb-sm">设备信息</div>
                  <div class="row q-col-gutter-sm">
                    <div class="col-12" v-if="peerDeviceInfo.cpu_model">
                      <div class="text-caption text-grey-6">CPU</div>
                      <div class="text-body2">
                        {{ peerDeviceInfo.cpu_model }}
                        <span v-if="peerDeviceInfo.cpu_cores" class="text-grey-6">
                          ({{ peerDeviceInfo.cpu_cores }}核{{ peerDeviceInfo.cpu_threads ? `/${peerDeviceInfo.cpu_threads}线程` : '' }})
                        </span>
                      </div>
                    </div>
                    <div class="col-12" v-if="peerDeviceInfo.memory_total_mb">
                      <div class="text-caption text-grey-6">内存</div>
                      <div class="text-body2">
                        {{ formatMemory(peerDeviceInfo.memory_total_mb) }}
                        <span v-if="peerDeviceInfo.memory_free_mb" class="text-grey-6">
                          (可用 {{ formatMemory(peerDeviceInfo.memory_free_mb) }})
                        </span>
                      </div>
                    </div>
                    <div class="col-12" v-if="peerDeviceInfo.os_name">
                      <div class="text-caption text-grey-6">操作系统</div>
                      <div class="text-body2">
                        {{ peerDeviceInfo.os_name }} {{ peerDeviceInfo.os_version || '' }}
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- IP地址信息 -->
                <div v-if="peerNodeInfo.network_config" class="q-mt-md q-pt-md border-top">
                  <div class="text-caption text-weight-medium text-grey-7 q-mb-sm">IP地址</div>
                  
                  <!-- 虚拟IP -->
                  <div v-if="peerNodeInfo.network_config.node_ip" class="q-mb-xs">
                    <div class="text-caption text-grey-6">虚拟IP</div>
                    <div class="text-body2">
                      <q-chip size="sm" color="primary" text-color="white" dense>
                        {{ peerNodeInfo.network_config.node_ip }}
                      </q-chip>
                    </div>
                  </div>
                  
                  <!-- 公网IP -->
                  <div v-if="getPublicIPs(peerNodeInfo.network_config).length > 0" class="q-mb-xs">
                    <div class="text-caption text-grey-6">公网IP</div>
                    <div class="q-gutter-xs">
                      <q-chip
                        v-for="ip in getPublicIPs(peerNodeInfo.network_config)"
                        :key="ip"
                        size="sm"
                        :color="isIPv6(ip) ? 'purple' : 'green'"
                        text-color="white"
                        dense
                      >
                        {{ ip }}
                        <q-tooltip>{{ isIPv6(ip) ? 'IPv6' : 'IPv4' }}</q-tooltip>
                      </q-chip>
                    </div>
                  </div>
                  
                  <!-- 局域网IP -->
                  <div v-if="peerNodeInfo.network_config.lan_ips?.length > 0" class="q-mb-xs">
                    <div class="text-caption text-grey-6">局域网IP</div>
                    <div class="q-gutter-xs">
                      <q-chip
                        v-for="ip in peerNodeInfo.network_config.lan_ips"
                        :key="ip"
                        size="sm"
                        color="orange"
                        text-color="white"
                        dense
                      >
                        {{ ip }}
                      </q-chip>
                    </div>
                  </div>
                </div>
              </div>
              <div v-else class="text-grey-6">加载中...</div>
            </q-card-section>
          </q-card>
        </div>
      </div>

      <!-- 连接状态卡片 -->
      <q-card class="q-mb-lg">
        <q-card-section>
          <div class="text-h6 q-mb-md">连接状态</div>
          <div class="row q-col-gutter-md">
            <div class="col-6 col-md-3">
              <div class="stat-item">
                <q-icon 
                  :name="connectionDetails.online ? 'link' : 'link_off'" 
                  :color="connectionDetails.online ? 'positive' : 'negative'"
                  size="md"
                />
                <div class="text-caption text-grey-6 q-mt-xs">连接状态</div>
                <div class="text-subtitle1 text-weight-medium">
                  {{ connectionDetails.online ? '在线' : '离线' }}
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="stat-item">
                <q-icon name="speed" color="info" size="md" />
                <div class="text-caption text-grey-6 q-mt-xs">连接类型</div>
                <div class="text-subtitle1 text-weight-medium">
                  {{ getConnectionTypeName(connectionDetails.conn_type) }}
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="stat-item">
                <q-icon name="timer" color="orange" size="md" />
                <div class="text-caption text-grey-6 q-mt-xs">延迟</div>
                <div class="text-subtitle1 text-weight-medium">
                  {{ connectionDetails.latency ? `${connectionDetails.latency.toFixed(1)} ms` : 'N/A' }}
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="stat-item">
                <q-icon name="schedule" color="grey" size="md" />
                <div class="text-caption text-grey-6 q-mt-xs">最后可见</div>
                <div class="text-subtitle1 text-weight-medium">
                  {{ formatDateTime(connectionDetails.seen_at) }}
                </div>
              </div>
            </div>
          </div>
        </q-card-section>
      </q-card>

      <!-- 流量统计 -->
      <q-card class="q-mb-lg">
        <q-card-section>
          <div class="text-h6 q-mb-md">流量统计 ({{ getTimeRangeLabel(historyTimeRange) }})</div>
          
          <!-- 流量统计数据 -->
          <div class="row q-col-gutter-md q-mb-md">
            <div class="col-12 col-md-4">
              <div class="stat-item">
                <q-icon name="download" color="positive" size="md" />
                <div class="text-caption text-grey-6 q-mt-xs">接收流量</div>
                <div class="text-h5 text-weight-medium text-positive">
                  {{ formatBytes(trafficStats.rx_bytes) }}
                </div>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="stat-item">
                <q-icon name="upload" color="primary" size="md" />
                <div class="text-caption text-grey-6 q-mt-xs">发送流量</div>
                <div class="text-h5 text-weight-medium text-primary">
                  {{ formatBytes(trafficStats.tx_bytes) }}
                </div>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="stat-item">
                <q-icon name="swap_vert" color="info" size="md" />
                <div class="text-caption text-grey-6 q-mt-xs">总流量</div>
                <div class="text-h5 text-weight-medium text-info">
                  {{ formatBytes(trafficStats.rx_bytes + trafficStats.tx_bytes) }}
                </div>
              </div>
            </div>
          </div>
          
          <!-- 平均速率 -->
          <div class="row q-col-gutter-md">
            <div class="col-6">
              <div class="text-caption text-grey-6">平均下载速率</div>
              <div class="text-subtitle1 text-weight-medium text-positive">
                {{ formatSpeed(trafficStats.avg_rx_speed) }}
              </div>
            </div>
            <div class="col-6">
              <div class="text-caption text-grey-6">平均上传速率</div>
              <div class="text-subtitle1 text-weight-medium text-primary">
                {{ formatSpeed(trafficStats.avg_tx_speed) }}
              </div>
            </div>
          </div>
        </q-card-section>
      </q-card>

      <!-- 连接历史 -->
      <q-card>
        <q-card-section>
          <div class="row items-center q-mb-md">
            <div class="text-h6">连接历史</div>
            <q-space />
            <q-btn-toggle
              v-model="historyViewMode"
              toggle-color="primary"
              size="sm"
              class="q-mr-md"
              :options="[
                { label: '图表', value: 'chart', icon: 'show_chart' },
                { label: '表格', value: 'table', icon: 'table_chart' }
              ]"
            />
            <q-btn-toggle
              v-model="historyTimeRange"
              toggle-color="primary"
              size="sm"
              :options="[
                { label: '1小时', value: '1h' },
                { label: '6小时', value: '6h' },
                { label: '24小时', value: '24h' }
              ]"
              @update:model-value="loadHistoryData"
            />
          </div>
          
          <!-- 图表视图 -->
          <div v-if="historyViewMode === 'chart'">
            <div v-if="historyLoading" class="text-center q-pa-xl">
              <q-spinner color="primary" size="3em" />
            </div>
            <div v-else-if="connectionHistory.length === 0" class="text-center q-pa-xl text-grey-6">
              <q-icon size="3em" name="info" />
              <div class="q-mt-md">暂无历史数据</div>
            </div>
            <div v-else>
              <!-- 延迟图表 -->
              <div class="q-mb-xl">
                <div class="text-subtitle2 q-mb-sm">延迟趋势 (ms)</div>
                <div ref="latencyChartContainer" style="width: 100%; height: 300px;"></div>
              </div>
              
              <!-- 流量图表 -->
              <div class="q-mb-xl">
                <div class="text-subtitle2 q-mb-sm">流量趋势</div>
                <div ref="trafficChartContainer" style="width: 100%; height: 300px;"></div>
              </div>
              
              <!-- 连接状态图表 -->
              <div>
                <div class="text-subtitle2 q-mb-sm">连接状态</div>
                <div ref="statusChartContainer" style="width: 100%; height: 200px;"></div>
              </div>
            </div>
          </div>
          
          <!-- 历史数据表格 -->
          <q-table
            v-else
            :rows="connectionHistory"
            :columns="historyColumns"
            :loading="historyLoading"
            row-key="id"
            flat
            dense
            :pagination="{ rowsPerPage: 20 }"
          >
            <!-- 时间列 -->
            <template #body-cell-snapshot_at="props">
              <q-td :props="props">
                {{ formatDateTime(props.row.snapshot_at) }}
              </q-td>
            </template>

            <!-- 状态列 -->
            <template #body-cell-online="props">
              <q-td :props="props">
                <q-icon
                  :name="props.row.online ? 'check_circle' : 'cancel'"
                  :color="props.row.online ? 'positive' : 'negative'"
                  size="sm"
                />
              </q-td>
            </template>

            <!-- 延迟列 -->
            <template #body-cell-latency="props">
              <q-td :props="props">
                <q-badge
                  :color="getLatencyColor(props.row.latency)"
                  :label="props.row.latency ? `${props.row.latency.toFixed(1)} ms` : '-'"
                />
              </q-td>
            </template>

            <!-- 流量列 -->
            <template #body-cell-rx_bytes="props">
              <q-td :props="props">
                {{ formatBytes(props.row.rx_bytes) }}
              </q-td>
            </template>

            <template #body-cell-tx_bytes="props">
              <q-td :props="props">
                {{ formatBytes(props.row.tx_bytes) }}
              </q-td>
            </template>

            <!-- 空数据 -->
            <template #no-data>
              <div class="full-width row flex-center text-grey-6 q-gutter-sm q-py-xl">
                <q-icon size="2em" name="info" />
                <span>暂无历史数据</span>
              </div>
            </template>
          </q-table>
        </q-card-section>
      </q-card>
    </div>
  </PageLayout>
</template>

<script setup lang="ts">
import { ref, onMounted, computed, watch, nextTick } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { api } from '../../services/api'
import { useNotify } from '../../composables/useNotify'
import { nodeService } from '../../services/node/nodeService'
import PageLayout from '../../components/layout/PageLayout.vue'
import { formatRelativeTime, formatBytes as utilFormatBytes, formatLatency } from '../../utils/dateFormat'
import * as echarts from 'echarts'
import type { NodeDeviceInfo } from '../../types/node'

const route = useRoute()
const router = useRouter()
const notify = useNotify()

const nodeId = computed(() => route.params.nodeId as string)
const peerId = computed(() => route.params.peerId as string)

const loading = ref(false)
const historyLoading = ref(false)
const loadingDeviceInfo = ref(false)
const historyTimeRange = ref('24h')
const historyViewMode = ref('chart')
const trafficStatsRange = ref('current')

const connectionDetails = ref<any>({})
const sourceNodeInfo = ref<any>(null)
const peerNodeInfo = ref<any>(null)
const sourceDeviceInfo = ref<NodeDeviceInfo | null>(null)
const peerDeviceInfo = ref<NodeDeviceInfo | null>(null)
const connectionHistory = ref<any[]>([])
const trafficStats = ref({
  rx_bytes: 0,
  tx_bytes: 0,
  avg_rx_speed: 0,
  avg_tx_speed: 0
})

// 图表容器引用
const latencyChartContainer = ref<HTMLElement>()
const trafficChartContainer = ref<HTMLElement>()
const statusChartContainer = ref<HTMLElement>()

// ECharts 实例
let latencyChart: echarts.ECharts | null = null
let trafficChart: echarts.ECharts | null = null
let statusChart: echarts.ECharts | null = null

// 页面标题
const pageTitle = computed(() => {
  if (sourceNodeInfo.value && peerNodeInfo.value) {
    return `${sourceNodeInfo.value.node_name} ↔ ${peerNodeInfo.value.node_name}`
  }
  return '连接详情'
})

const pageSubtitle = computed(() => {
  return '查看两个节点之间的连接状态和历史数据'
})

// 历史数据表格列
const historyColumns = [
  {
    name: 'snapshot_at',
    label: '时间',
    field: 'snapshot_at',
    align: 'left' as const,
    sortable: true
  },
  {
    name: 'online',
    label: '状态',
    field: 'online',
    align: 'center' as const
  },
  {
    name: 'conn_type',
    label: '连接类型',
    field: 'conn_type',
    align: 'center' as const
  },
  {
    name: 'latency',
    label: '延迟',
    field: 'latency',
    align: 'center' as const
  },
  {
    name: 'rx_bytes',
    label: '接收',
    field: 'rx_bytes',
    align: 'right' as const
  },
  {
    name: 'tx_bytes',
    label: '发送',
    field: 'tx_bytes',
    align: 'right' as const
  }
]

// 加载连接详情
const loadConnectionDetails = async () => {
  try {
    loading.value = true
    
    // 1. 先从路由配置获取基本信息
    const routeDataResponse = await api.get('/route/data')
    
    if (routeDataResponse.data && routeDataResponse.data.data) {
      const routeData = routeDataResponse.data.data
      const allRoutes = routeData.routes || []
      
      // 查找对应的路由配置
      const route = allRoutes.find((r: any) => {
        const sourceId = String(r.node_id || r.source_node_id)
        const targetId = String(r.target_node_id)
        return sourceId === String(nodeId.value) && targetId === String(peerId.value)
      })
      
      if (route) {
        // 设置基本路由信息
        connectionDetails.value = {
          route_id: route.route_id,
          node_id: route.node_id,
          target_node_id: route.target_node_id,
          target_network: route.target_network,
          target_mask: route.target_mask,
          relay_mode: route.relay_mode,
          priority: route.priority,
          route_status: route.status,
          created_at: route.created_at,
          updated_at: route.updated_at
        }
        
        // 设置对端节点信息
        peerNodeInfo.value = {
          node_id: route.target_node_id,
          node_name: route.target_node_name || `Node ${route.target_node_id}`,
          user_name: route.target_user_name || '未知用户',
          user_email: route.target_user_email,
          node_status: route.target_node_status,
          vpn_type: route.target_vpn_type,
          endpoint: route.target_endpoint
        }
        
        // 设置本地节点信息
        sourceNodeInfo.value = {
          node_id: route.node_id,
          node_name: route.source_node_name || `Node ${route.node_id}`,
          user_name: route.source_user_name || '未知用户',
          user_email: route.source_user_email,
          node_status: route.source_node_status,
          vpn_type: route.source_vpn_type,
          endpoint: route.source_endpoint
        }
      }
    }
    
    // 2. 使用监控API获取实时状态（最新一条）
    try {
      const monitorResponse = await api.get('/monitor/history/connections', {
        params: {
          node_id: nodeId.value,
          peer_node_id: peerId.value,
          last: 1 // 获取最新一条数据
        }
      })
      
      if (monitorResponse.data && monitorResponse.data.data) {
        const connections = monitorResponse.data.data.connections || []
        if (connections.length > 0) {
          const conn = connections[0]
          
          // 补充实时监控数据
          if (connectionDetails.value) {
            connectionDetails.value = {
              ...connectionDetails.value,
              // 实时状态
              online: conn.online,
              status: conn.online ? 'online' : 'offline',
              connection_type: conn.conn_type,
              latency: conn.latency,
              bytes_sent: conn.tx_bytes,
              bytes_received: conn.rx_bytes,
              last_seen: conn.seen_at,
              last_active: conn.seen_at
            }
          }
        }
      }
    } catch (error) {
      console.warn('获取监控数据失败，仅显示路由配置信息:', error)
    }
    
    // 加载历史数据
    await loadHistoryData()
    
    // 加载设备信息
    await loadDeviceInfo()
    
    // 获取节点的网络配置信息
    try {
      const [sourceNodeResponse, peerNodeResponse] = await Promise.allSettled([
        api.get(`/nodes/${nodeId.value}`),
        api.get(`/nodes/${peerId.value}`)
      ])
      
      if (sourceNodeResponse.status === 'fulfilled' && sourceNodeResponse.value.data.success) {
        const nodeData = sourceNodeResponse.value.data.data
        console.log('本节点网络配置:', nodeData.network_config)
        if (sourceNodeInfo.value) {
          sourceNodeInfo.value.network_config = nodeData.network_config || {}
        }
      }
      
      if (peerNodeResponse.status === 'fulfilled' && peerNodeResponse.value.data.success) {
        const nodeData = peerNodeResponse.value.data.data
        console.log('对端节点网络配置:', nodeData.network_config)
        if (peerNodeInfo.value) {
          peerNodeInfo.value.network_config = nodeData.network_config || {}
        }
      }
    } catch (error) {
      console.warn('获取节点网络配置失败:', error)
    }
    
  } catch (error) {
    console.error('加载连接详情失败:', error)
    notify.error('加载连接详情失败')
  } finally {
    loading.value = false
  }
}

// 加载历史数据
const loadHistoryData = async () => {
  try {
    historyLoading.value = true
    
    const timeRanges: Record<string, { hours: number }> = {
      '1h': { hours: 1 },
      '6h': { hours: 6 },
      '24h': { hours: 24 },
      '7d': { hours: 168 }
    }
    
    const range = timeRanges[historyTimeRange.value] || { hours: 24 }
    const endTime = new Date()
    const startTime = new Date(endTime.getTime() - range.hours * 60 * 60 * 1000)
    
    const response = await api.get('/monitor/history/connections', {
      params: {
        node_id: nodeId.value,
        peer_node_id: peerId.value,
        start_time: startTime.toISOString().slice(0, 19).replace('T', ' '),
        end_time: endTime.toISOString().slice(0, 19).replace('T', ' '),
        per_page: 100
      }
    })
    
    if (response.data && response.data.data) {
      connectionHistory.value = response.data.data.connections || []
      
      // 如果有节点元数据，更新节点信息
      const metadata = response.data.data.nodes_metadata
      if (metadata) {
        if (metadata[nodeId.value] && !sourceNodeInfo.value) {
          sourceNodeInfo.value = metadata[nodeId.value]
        }
        if (metadata[peerId.value] && !peerNodeInfo.value) {
          peerNodeInfo.value = metadata[peerId.value]
        }
      }
    }
  } catch (error) {
    console.error('加载历史数据失败:', error)
    notify.error('加载历史数据失败')
  } finally {
    historyLoading.value = false
  }
}

// 辅助方法
const getStatusColor = (status: number) => {
  if (status === 2) return 'positive' // 在线
  if (status === 1) return 'info' // 启用但离线
  return 'grey' // 禁用
}

const getStatusText = (status: number) => {
  if (status === 2) return '在线'
  if (status === 1) return '启用'
  return '禁用'
}

const getConnectionTypeName = (type: string) => {
  if (!type) return 'N/A'
  
  const typeMap: Record<string, string> = {
    'direct_ipv4': '直连 IPv4',
    'direct_ipv6': '直连 IPv6',
    'relay': '中继',
    'derp': 'DERP 中继'
  }
  return typeMap[type] || type
}

const getLatencyColor = (latency: number) => {
  if (!latency) return 'grey'
  if (latency < 50) return 'positive'
  if (latency < 100) return 'info'
  if (latency < 200) return 'orange'
  return 'negative'
}

const formatBytes = utilFormatBytes
const formatDateTime = formatRelativeTime

const formatMemory = (mb: number) => {
  if (!mb) return '0 MB'
  if (mb >= 1024) {
    return `${(mb / 1024).toFixed(1)} GB`
  }
  return `${mb} MB`
}

const formatSpeed = (bytesPerSecond: number) => {
  if (!bytesPerSecond) return '0 B/s'
  
  const units = ['B/s', 'KB/s', 'MB/s', 'GB/s']
  let value = bytesPerSecond
  let unitIndex = 0
  
  while (value >= 1024 && unitIndex < units.length - 1) {
    value /= 1024
    unitIndex++
  }
  
  return `${value.toFixed(2)} ${units[unitIndex]}`
}

const getPublicIPs = (networkConfig: any) => {
  const ips: string[] = []
  if (networkConfig?.public_ips?.length) {
    ips.push(...networkConfig.public_ips.filter((ip: string) => ip.trim()))
  }
  return ips
}

const isIPv6 = (ip: string) => {
  return ip.includes(':')
}

const getTimeRangeLabel = (range: string) => {
  const labels: Record<string, string> = {
    '1h': '1小时',
    '6h': '6小时',
    '24h': '24小时'
  }
  return labels[range] || range
}

// 加载节点设备信息
const loadDeviceInfo = async () => {
  try {
    loadingDeviceInfo.value = true
    
    // 并行加载两个节点的设备信息
    const [sourceResponse, peerResponse] = await Promise.allSettled([
      nodeService.getNodeDeviceInfo(nodeId.value),
      nodeService.getNodeDeviceInfo(peerId.value)
    ])
    
    if (sourceResponse.status === 'fulfilled' && sourceResponse.value.success && sourceResponse.value.data.exists) {
      sourceDeviceInfo.value = sourceResponse.value.data.device_info
    }
    
    if (peerResponse.status === 'fulfilled' && peerResponse.value.success && peerResponse.value.data.exists) {
      peerDeviceInfo.value = peerResponse.value.data.device_info
    }
  } catch (error) {
    console.error('加载设备信息失败:', error)
  } finally {
    loadingDeviceInfo.value = false
  }
}

// 计算流量统计（根据时间范围）
const calculateTrafficStats = () => {
  if (connectionHistory.value.length === 0) {
    trafficStats.value = {
      rx_bytes: 0,
      tx_bytes: 0,
      avg_rx_speed: 0,
      avg_tx_speed: 0
    }
    return
  }
  
  // 获取最新和最早的数据点
  const latest = connectionHistory.value[0]
  const oldest = connectionHistory.value[connectionHistory.value.length - 1]
  
  const rxBytes = (latest.rx_bytes || 0) - (oldest.rx_bytes || 0)
  const txBytes = (latest.tx_bytes || 0) - (oldest.tx_bytes || 0)
  
  // 计算时间差（秒）
  const timeDiff = (new Date(latest.snapshot_at).getTime() - new Date(oldest.snapshot_at).getTime()) / 1000
  
  trafficStats.value = {
    rx_bytes: rxBytes,
    tx_bytes: txBytes,
    avg_rx_speed: timeDiff > 0 ? rxBytes / timeDiff : 0,
    avg_tx_speed: timeDiff > 0 ? txBytes / timeDiff : 0
  }
}

// 初始化图表
const initCharts = async () => {
  await nextTick()
  
  if (connectionHistory.value.length === 0) return
  
  // 准备数据
  const reversedHistory = [...connectionHistory.value].reverse()
  const times = reversedHistory.map(item => 
    new Date(item.snapshot_at).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
  )
  
  const latencies = reversedHistory.map(item => item.latency || 0)
  
  // 计算流量增量（当前值 - 前一个值）
  const rxIncrements: number[] = []
  const txIncrements: number[] = []
  
  for (let i = 0; i < reversedHistory.length; i++) {
    if (i === 0) {
      rxIncrements.push(0)
      txIncrements.push(0)
    } else {
      const rxDiff = (reversedHistory[i].rx_bytes || 0) - (reversedHistory[i - 1].rx_bytes || 0)
      const txDiff = (reversedHistory[i].tx_bytes || 0) - (reversedHistory[i - 1].tx_bytes || 0)
      // 转换为MB并确保非负
      rxIncrements.push(Math.max(0, rxDiff / 1024 / 1024))
      txIncrements.push(Math.max(0, txDiff / 1024 / 1024))
    }
  }
  
  const onlineStatus = reversedHistory.map(item => item.online ? 1 : 0)
  
  // 延迟图表
  if (latencyChartContainer.value) {
    if (latencyChart) {
      latencyChart.dispose()
    }
    latencyChart = echarts.init(latencyChartContainer.value)
    latencyChart.setOption({
      tooltip: {
        trigger: 'axis',
        formatter: '{b}<br/>延迟: {c} ms'
      },
      grid: {
        left: '3%',
        right: '4%',
        bottom: '3%',
        containLabel: true
      },
      xAxis: {
        type: 'category',
        boundaryGap: false,
        data: times
      },
      yAxis: {
        type: 'value',
        name: '延迟 (ms)'
      },
      series: [{
        name: '延迟',
        type: 'line',
        smooth: true,
        data: latencies,
        areaStyle: {
          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
            { offset: 0, color: 'rgba(255, 152, 0, 0.3)' },
            { offset: 1, color: 'rgba(255, 152, 0, 0.05)' }
          ])
        },
        itemStyle: {
          color: '#ff9800'
        }
      }]
    })
  }
  
  // 流量图表
  if (trafficChartContainer.value) {
    if (trafficChart) {
      trafficChart.dispose()
    }
    trafficChart = echarts.init(trafficChartContainer.value)
    trafficChart.setOption({
      tooltip: {
        trigger: 'axis',
        formatter: (params: any) => {
          let result = params[0].axisValue + '<br/>'
          params.forEach((param: any) => {
            result += `${param.marker}${param.seriesName}: ${param.value.toFixed(2)} MB<br/>`
          })
          return result
        }
      },
      legend: {
        data: ['接收增量', '发送增量']
      },
      grid: {
        left: '3%',
        right: '4%',
        bottom: '3%',
        containLabel: true
      },
      xAxis: {
        type: 'category',
        boundaryGap: false,
        data: times
      },
      yAxis: {
        type: 'value',
        name: '流量增量 (MB)'
      },
      series: [
        {
          name: '接收增量',
          type: 'line',
          smooth: true,
          data: rxIncrements,
          areaStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: 'rgba(33, 150, 243, 0.3)' },
              { offset: 1, color: 'rgba(33, 150, 243, 0.05)' }
            ])
          },
          itemStyle: {
            color: '#2196f3'
          }
        },
        {
          name: '发送增量',
          type: 'line',
          smooth: true,
          data: txIncrements,
          areaStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: 'rgba(76, 175, 80, 0.3)' },
              { offset: 1, color: 'rgba(76, 175, 80, 0.05)' }
            ])
          },
          itemStyle: {
            color: '#4caf50'
          }
        }
      ]
    })
  }
  
  // 连接状态图表（柱状图）
  if (statusChartContainer.value) {
    if (statusChart) {
      statusChart.dispose()
    }
    statusChart = echarts.init(statusChartContainer.value)
    statusChart.setOption({
      tooltip: {
        trigger: 'axis',
        formatter: (params: any) => {
          const status = params[0].value === 1 ? '在线' : '离线'
          const color = params[0].value === 1 ? '#4caf50' : '#f44336'
          return `${params[0].axisValue}<br/><span style="color:${color}">● ${status}</span>`
        }
      },
      grid: {
        left: '3%',
        right: '4%',
        bottom: '3%',
        containLabel: true
      },
      xAxis: {
        type: 'category',
        data: times
      },
      yAxis: {
        type: 'value',
        min: 0,
        max: 1,
        interval: 1,
        axisLabel: {
          formatter: (value: number) => value === 1 ? '在线' : '离线'
        }
      },
      series: [{
        name: '状态',
        type: 'bar',
        data: onlineStatus,
        itemStyle: {
          color: (params: any) => {
            return params.value === 1 ? '#4caf50' : '#f44336'
          }
        },
        barWidth: '60%'
      }]
    })
  }
}

// 监听视图模式和历史数据变化
watch([historyViewMode, () => connectionHistory.value.length], () => {
  if (historyViewMode.value === 'chart' && connectionHistory.value.length > 0) {
    nextTick(() => {
      initCharts()
    })
  }
})

// 监听历史数据变化以计算流量统计
watch(() => connectionHistory.value.length, () => {
  calculateTrafficStats()
})

// 监听窗口大小变化
if (typeof window !== 'undefined') {
  window.addEventListener('resize', () => {
    latencyChart?.resize()
    trafficChart?.resize()
    statusChart?.resize()
  })
}

const handleBack = () => {
  router.push(`/app/routes/active/${nodeId.value}`)
}

// 初始化
onMounted(() => {
  loadConnectionDetails()
})
</script>

<style lang="scss" scoped>
.stat-item {
  text-align: center;
  padding: 1rem;
}

.border-top {
  border-top: 1px solid rgba(0, 0, 0, 0.12);
}
</style>
