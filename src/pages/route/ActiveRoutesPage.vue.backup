import { api } from '../../services/api'
import type { Node, Route } from '../../types'
import type { NodeStatus } from '../../types/node'
import { NodeStatusManager, normalizeNodeStatus } from '../../utils/nodeStatus'

const { t } = useI18n()
const router = useRouter()
const notify = useNotify()

const {
  loading,
  activeRoutes,, watch } from 'vue'
import debug from "../../utils/debug"
import { useI18n } from 'vue-i18n'
import { useRouter, useRoute } from 'vue-router'
import { useRoutes } from '../../composables/useRoutes'
import { useNodes } from '../../composables/useNodes'
import { useNotify } from '../../composables/useNotify'
import PageLayout from '../../components/layout/PageLayout.vue'
import ResponsiveCardGrid from '../../components/common/ResponsiveCardGrid.vue'
import RouteDetailsDialog from '../../components/route/RouteDetailsDialog.vue'
import RouteListView from '../../components/route/RouteListView.vue'
import { api } from '../../services/api'
import type { Node, Route } from '../../types'
import type { NodeStatus } from '../../types/node'
import { NodeStatusManager, normalizeNodeStatus } from '../../utils/nodeStatus'

const { t } = useI18n()
const router = useRouter()
const route = useRoute
const routeDetailsDialog = ref({
  show: false,
  route: null as any
})

// 计算属性
const filteredNodes = computed(() => {
  return nodes.value.filter(node => {
    // 使用 node_status 数值：1(启用但离线) 和 2(启用且在线) 的节点都应该显示
    const nodeStatus = node.node_status
    return nodeStatus === 1 || nodeStatus === 2
  })
})

const hasAvailableNodes = computed(() => filteredNodes.value.length > 0)
selectedNodeInfo = ref<any>(null)
const nodeRoutesList = ref<any[]>([])
const routesLoading = ref(false)
const displayMode = ref<'card' | 'list'>('card')

// 对话框状态
const routeDetailsDialog = ref({
  show: false,
  route: null as any
})

// 路由参数
const currentNodeId = computed(() => route.params.nodeId as string)

// 当前视图判断
const currentView = computed(() => {
  const { nodeId } = route.params
  const { name } = route
  
  if (!nodeId) {
    return 'node-list' // 节点列表视图
  } else if (name === 'routes-active-node-list') {
    return 'routes-list' // 路由列表视图（表格模式）
  } else {
    return 'routes-card' // 路由卡片视图
  }
})

// 页面标题
const pageTitle = computed(() => {
  if (currentView.value === 'node-list') {
    return t('navigation.activeRoutes')
  } else if (selectedNodeInfo.value) {
    return `${selectedNodeInfo.value.node_name} - 路由列表`
  }
  return '路由详情'
})

const pageSubtitle = computed(() => {
  if (currentView.value === 'node-list') {
    return t('routes.activeRoutes.subtitle')
  }
  return '查看节点的活跃连接'= 'unconfigured' || status === 'pending'
  }).length
  const disabled = nodes.value.filter(n => {
    const status = n.status || n.node_status
    return status === 'disabled' || status === 'inactive'
  }).length
  
  return {
    total,
    available,
    unconfigured,
    disabled
  }
})

// 节点相关方法
const getNodeRouteCount = (node: any) => {
  // 计算节点的活跃路由数量
  const nodeId = node.node_id || node.id
  const nodeRoutes = activeRoutes.value.filter(route => 
    route.node_id === nodeId || route.target_node_id === nodeId
  )
  return nodeRoutes.length
}

// 路由数据处理方法
const processNodesByUserEmail = (nodes: any[]) => {
  if (!Array.isArray(nodes) || nodes.length === 0) {
    return []
  }

  // 按 user_email 分组
  const groupedByUser = nodes.reduce((groups: Record<string, any[]>, node: any) => {
    const userKey = node.user_email || 'unknown'
    if (!groups[userKey]) {
      groups[userKey] = []
    }
    groups[userKey].push(node)
    return groups
  }, {})

  // 处理每个分组，为每个节点添加分组信息
  const processedNodes: any[] = []
  
  Object.entries(groupedByUser).forEach(([userEmail, userNodes]) => {
  const nodeId = node.node_id || node.id
  // 通过路由跳转，而不是直接设置状态
  router.push(`/app/routes/active/${nodeId}`
        _groupInfo: {
          userEmail,
          isFirstInGroup: index === 0,
          groupSize: userNodes.length
        }
      })
    })
  })
  
  return processedNodes
}

// 事件处理
const handleNodeSelect = async (node: any, index: number) => {
  selectedNode.value = node
  const nodeId = node.node_id || node.id
  await fetchNodeRoutes(nodeId)
}

const fetchNodeRoutes = async (nodeId: string | number) => {
  try {
    routesLoading.value = true
    debug.log('获取节点路由:', nodeId)
    
    const response = await api.get(`/route/node/${nodeId}`)
    debug.log('节点路由数据:', response.data)
     = () => {
  router.push('/app/routes/active')
}

const handleBackToNodes = () => {
  router.push('/app/routes/active')
}currentNodeId.value) {
    await fetchNodeRoutes(currentNodeId.valuede: 'card' | 'list') => {
  const nodeId = currentNodeId.value
  
  if (mode === 'list') {
    router.push(`/app/routes/active/${nodeId}/list`)
  } else {
    router.push(`/app/routes/active/${nodeId}`)
  }
}

const handleConnectionClick = (connection: any) => {
  const peerId = connection.peer_id || connection.node_id
  router.push(`/app/routes/active/${currentNodeId.value}/p-${peerId}`)sArray(response.data.data) ? response.data.data : []
      nodeRoutesList.value = processNodesByUserEmail(nodes)
    } else {
      nodeRoutesList.value = []
    }
    
  } catch (error) {
    debug.error('获取节点路由失败:', error)
    nodeRoutesList.value = []
    notify.error(t('routes.errors.fetchNodeRoutesFailed'))
  } finally {
    routesLoading.value = false
  }
}

const handleBackToNodes = () => {
  selectedNode.value = null
  nodeRoutesList.value = []
}

const handleRefreshRoutes = async () => {
  if (selectedNode.value) {
    const nodeId = (selectedNode.value as any).node_id || (selectedNode.value as any).id
    await fetchNodeRoutes(nodeId)
  } else {
    await loadNodes()
    await fetchActiveRoutes()
  }
}

const handleCreateRoute = () => {
  router.push('/app/routes/create/prev_1')
}

const handleDisconnectRoute = (routeId: string) => {
  disconnectRoute(routeId)
}

const handleViewRouteDetails = (route: any) => {
  routeDetailsDialog.value = {
    show: true,
    route
  }
}

// 路由数据显示方法
const getFriendName = (node: any) => {
  return node.user_name || node.user_email || '未知用户'
}

const getTargetNodeName = (node: any) => {
  return node.node_name || '未知节点'
}监听路由参数变化
watch(
  () => route.params.nodeId,
  async (newNodeId) => {
    if (newNodeId) {
      await fetchNodeRoutes(newNodeId)
      // 获取节点信息
      const node = nodes.value.find((n: any) => 
        String(n.node_id || n.id) === String(newNodeId)
      )
      if (node) {
        selectedNodeInfo.value = node
        selectedNode.value = node
      }
    } else {
      selectedNode.value = null
      selectedNodeInfo.value = null
      nodeRoutesList.value = []
    }
  },
  { immediate: true }
)

// 监听路由名称变化，更新显示模式
watch(
  () => route.name,
  (newName) => {
    if (newName === 'routes-active-node-list') {
      displayMode.value = 'list'
    } else if (newName === 'routes-active-node') {
      displayMode.value = 'card'
    }
  },
  { immediate: true }
)

// 

const getTargetNodeIP = (node: any) => {
  const nodeIp = node.ip_addresses?.find((ip: any) => ip.route_type === 'node_ip')
  return nodeIp?.ip_address || 'N/A'
}

const getNodeSource = (node: any) => {
  const sourceMap: Record<string, string> = {
    'self': '当前节点',
    'user_node': '用户节点',
    'friend_node': '好友节点'
  }
  return sourceMap[node.source] || node.source || '未知'
}

const getIpTypeColor = (routeType: string) => {
  const colorMap: Record<string, string> = {
    'node_ip': 'primary',
    'lan_ip': 'positive',
    'wan_ip': 'info'
  }
  return colorMap[routeType] || 'grey'
}

const getIpTypeLabel = (routeType: string) => {
  const labelMap: Record<string, string> = {
    'node_ip': '节点IP',
    'lan_ip': '局域网IP',
    'wan_ip': '广域网IP'
  }
  return labelMap[routeType] || routeType
}

// 初始化
onMounted(async () => {
  await loadNodes()
  await fetchActiveRoutes()
})
</script>

