  :deep(.q-card) {
    min-height: auto;
    
    .q-card__section {
      padding: 12px 16px;
    }
  }
}

.routes-view {
  .node-info-header {
    background: linear-gradient(135deg, rgba(var(--q-primary-rgb), 0.05) 0%, rgba(var(--q-primary-rgb), 0.02) 100%);
    border-left: 4px solid var(--q-primary);
  }
  
  .user-group-header {
    margin-top: 16px;
    
    &:first-child {
      margin-top: 0;
    }
  }
  
  :deep(.q-card) {
    .q-card__section {
      padding: 16px;
    }
  }
}
