{
  "name": "mynet-quasar",
  "version": "1.0.0",
  "description": "MyNet Quasar Application",
  "productName": "MyNet",
  "author": "MyNet Team",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "build:electron": "quasar build -m electron",
    "build:capacitor": "quasar build -m capacitor",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint --ext .js,.ts,.vue ./src",
    "lint:fix": "eslint --ext .js,.ts,.vue ./src --fix",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.9",
    "axios": "^1.6.0",
    "date-fns": "^4.1.0",
    "pinia": "^2.1.0",
    "quasar": "^2.14.0",
    "vue": "^3.4.0",
    "vue-i18n": "^12.0.0-alpha.3",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.2.1",
    "@quasar/cli": "^2.3.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "sass": "^1.69.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": "^18 || ^20 || ^21 || ^22 || ^24",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
