# MyNet Frontend Environment Configuration
# 生产环境配置文件
#
# ⚠️ 文件名必须是 .env.prod，不能写成 Vite/CRA 惯例的 .env.production。
# Quasar 用自己的命名法：@quasar/app-vite/lib/utils/env.js:31 把 buildType 定为
# ctx.dev ? 'dev' : 'prod'，查找序（后者覆盖前者）为
#   .env → .env.local → .env.[dev|prod] → .env.local.[dev|prod]
#        → .env.[quasarMode] → … → .env.[dev|prod].[quasarMode] → …
# 里面没有 development/production，按那个名字建的文件永远不会被加载。
# 另注：quasar.config.ts 的 build.env 会覆盖本文件的值，它靠 loadEnvProduction()
# 读本文件填 process.env，所以改名时两处必须同步。
#
# GUARD-OK A3 只按文件名拦；本文件是团队共享的前端构建期配置（API 域名 + Reverb
# 客户端公开值），不含凭据，且 Quasar 按固定文件名查找、必须入库。

# 应用环境
NODE_ENV=production

# API配置 —— 留空即同源（相对路径）：后端 API 部署地址不入构建产物、不暴露
VITE_API_BASE_URL=
VITE_WS_URL=

# WebSocket配置 (Laravel Reverb)
# 注意：必须走 my.mynet.club nginx 代理（/wss/ → 127.0.0.1:1080）
# 禁止直填后端/Reverb 内网地址，外网端口未开放
VITE_PUSHER_APP_KEY=oyzmmhlqzmar2uvanq2k
VITE_REVERB_APP_ID=686554
VITE_REVERB_HOST=my.mynet.club
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# 应用配置
VITE_APP_TITLE=MyNet
VITE_APP_DESCRIPTION=MyNet Network Management System
VITE_APP_VERSION=1.0.0

# 功能开关
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# 安全配置
VITE_ENABLE_HTTPS=true
VITE_ENABLE_CSRF=true

# 缓存配置
VITE_CACHE_TIMEOUT=300000
VITE_ENABLE_CACHE=true

# 日志配置
VITE_LOG_LEVEL=error
VITE_ENABLE_CONSOLE_LOG=false
