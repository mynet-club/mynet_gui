# embed 模式构建期配置（相对路径挂载，产物内嵌进 mynet/mynetd 发行包）
#
# ═══ 构建口径分工（2026-10-30 拆开，别再合并这两个文件）═══
#   .env.embed = embed 构建 —— 本文件，/gui/ 基路径（发行包内嵌 WebUI 的挂载点）
#   .env.prod  = web 构建（my.mynet.club 根路径 + /api/ 同源代理）—— 不是本文件！
# 取本文件构建用 `npm run build:embed`（经 .env.local.prod 注入，构建后自动清掉，
# 不碰 .env.prod）；mynet_desktop release.yml 的拷贝舞步只在 CI 临时 checkout 里做。
# 判据：产物 dist/spa/index.html 必须引 /gui/assets/（release.yml 就查这条）。
#
# GUARD-OK A3 只按文件名拦；本文件只有相对路径与开关，不含任何凭据，
# 且 Quasar 按固定文件名查找、必须入库。
NODE_ENV=production
VITE_API_BASE_URL=/gui
VITE_WWW_URL=/
VITE_APP_TITLE=MyNet 控制台
VITE_ENABLE_DEBUG=false
VITE_ENABLE_CONSOLE_LOG=false
VITE_LOG_LEVEL=error
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false
VITE_ROUTER_BASE=/gui/
