# embed 模式构建期配置（相对路径挂载，产物内嵌进发行包）
#
# GUARD-OK A3 只按文件名拦；本文件只有相对路径与开关，不含任何凭据，
# 且 Quasar 按固定文件名查找、必须入库。
NODE_ENV=production
VITE_API_BASE_URL=/gui
VITE_WWW_URL=/
VITE_APP_TITLE=MyNet 控制台
VITE_ENABLE_DEBUG=false
VITE_ENABLE_CONSOLE_LOG=false
VITE_LOG_LEVEL=error
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false
VITE_ROUTER_BASE=/gui/
