# MyNet Frontend Environment Configuration
# 开发环境配置文件
#
# ⚠️ 文件名必须是 .env.dev，不能写成 Vite/CRA 惯例的 .env.development。
# Quasar 用自己的命名法：@quasar/app-vite/lib/utils/env.js:31 把 buildType 定为
# ctx.dev ? 'dev' : 'prod'，查找序（后者覆盖前者）为
#   .env → .env.local → .env.[dev|prod] → .env.local.[dev|prod]
#        → .env.[quasarMode] → … → .env.[dev|prod].[quasarMode] → …
# 里面没有 development/production，按那个名字建的文件永远不会被加载。
#
# ⚠️ 本地个人覆盖不能写 .env.local —— 它排在 .env.dev **前面**，会被本文件覆盖掉
# （优先级与 Vite 相反）。要覆盖本文件必须写 .env.local.dev（查找序第 4 位）。
# 注意 .gitignore 的 .env.*.local 匹配不到 .env.local.dev，建它之前先补 .gitignore。
# 本文件是团队共享的非机密前端配置，需入库。
#
# GUARD-OK A3 只按文件名拦；本文件是团队共享的前端构建期配置（API 域名 + Reverb
# 客户端公开值），不含凭据，且 Quasar 按固定文件名查找、必须入库。

# 应用环境
NODE_ENV=development

# API配置
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:1080

# WebSocket配置 (Laravel Reverb)
VITE_PUSHER_APP_KEY=oyzmmhlqzmar2uvanq2k
VITE_REVERB_APP_ID=686554
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=1080
VITE_REVERB_SCHEME=ws

# 应用配置
VITE_APP_TITLE=MyNet (Development)
VITE_APP_DESCRIPTION=MyNet Network Management System - Development
VITE_APP_VERSION=1.0.0-dev

# 功能开关
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# 安全配置
VITE_ENABLE_HTTPS=false
VITE_ENABLE_CSRF=true

# 缓存配置
VITE_CACHE_TIMEOUT=30000
VITE_ENABLE_CACHE=false

# 日志配置
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOG=true
