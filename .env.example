# MyNet 环境变量配置示例
# 复制此文件为 .env 用于开发环境
# 复制此文件为 .env.production 用于生产环境

# API 基础地址
VITE_API_BASE_URL=http://localhost:8000

# 官网地址
VITE_WWW_URL=https://mynet.club

# WebSocket 地址
VITE_WS_URL=ws://localhost:8000

# Pusher/Reverb 配置
VITE_PUSHER_APP_KEY=local
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ==========================================
# 调试配置（开发环境专用）
# ==========================================

# 启用调试模式（开发环境建议为 true，生产环境为 false）
VITE_ENABLE_DEBUG=true

# 日志级别（debug/info/warn/error）
# - debug: 显示所有日志
# - info:  显示 info/warn/error
# - warn:  显示 warn/error
# - error: 仅显示 error
VITE_LOG_LEVEL=debug

# ==========================================
# 重要说明
# ==========================================

# 1. console.log 自动移除机制：
#    - 开发环境（npm run dev）：保留所有 console.log
#    - 生产环境（npm run build）：自动移除 console.log/console.info/console.debug
#    - 生产环境保留：console.warn/console.error（用于错误追踪）

# 2. 为什么不需要手动删除 console.log：
#    - Terser 在生产构建时会自动删除调试代码
#    - 开发时可以自由使用 console.log 调试
#    - 不影响生产环境性能和安全性

# 3. 最佳实践：
#    - 开发调试：随意使用 console.log
#    - 重要错误：使用 console.error
#    - 警告信息：使用 console.warn
#    - 避免在生产环境输出敏感信息
