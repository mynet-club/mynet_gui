# MyNet Frontend Environment Configuration
# 生产环境配置文件

# 应用环境
NODE_ENV=production

# API配置
VITE_API_BASE_URL=https://my.mynet.club
VITE_WS_URL=wss://my.mynet.club/wss

# WebSocket配置 (Laravel Reverb)
# 注意：必须走 my.mynet.club nginx 代理（/wss/ → 127.0.0.1:1080）
# 禁止直接填 api.mynet.club:1080，外网端口未开放
VITE_PUSHER_APP_KEY=oyzmmhlqzmar2uvanq2k
VITE_REVERB_APP_ID=686554
VITE_REVERB_HOST=my.mynet.club
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# 应用配置
VITE_APP_TITLE=MyNet
VITE_APP_DESCRIPTION=MyNet Network Management System
VITE_APP_VERSION=1.0.0

# 功能开关
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# 安全配置
VITE_ENABLE_HTTPS=true
VITE_ENABLE_CSRF=true

# 缓存配置
VITE_CACHE_TIMEOUT=300000
VITE_ENABLE_CACHE=true

# 日志配置
VITE_LOG_LEVEL=error
VITE_ENABLE_CONSOLE_LOG=false
