# MyNet Frontend Environment Configuration
# 默认开发环境配置文件
#
# GUARD-OK A3 只按文件名拦；本文件是团队共享的前端构建期配置（API 域名 + Reverb
# 客户端公开值），不含凭据，且 Quasar 按固定文件名查找、必须入库。

# 应用环境
NODE_ENV=development

# API配置
VITE_API_BASE_URL=http://api.mynet.local
VITE_WS_URL=ws://api.mynet.local:1080
VITE_WWW_URL=http://mynet.local

# WebSocket配置 (Laravel Reverb)
VITE_PUSHER_APP_KEY=oyzmmhlqzmar2uvanq2k
VITE_REVERB_APP_ID=686554
VITE_REVERB_HOST=api.mynet.local
VITE_REVERB_PORT=1080
VITE_REVERB_SCHEME=ws

# 应用配置
VITE_APP_TITLE=MyNet (Development)
VITE_APP_DESCRIPTION=MyNet Network Management System - Development
VITE_APP_VERSION=1.0.0-dev

# 功能开关
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# 安全配置
VITE_ENABLE_HTTPS=true
VITE_ENABLE_CSRF=true

# 缓存配置
VITE_CACHE_TIMEOUT=300000
VITE_ENABLE_CACHE=true

# 日志配置
VITE_LOG_LEVEL=error
VITE_ENABLE_CONSOLE_LOG=false
