{
  "name": "mynet-quasar",
  "version": "2.2.0",
  "description": "MyNet Quasar Application - v2.2.0 (back_api v2.2.0 compatible)",
  "productName": "MyNet",
  "author": "MyNet Team",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:prod": "quasar build",
    "build:embed": "node dev-tools/build-embed.mjs",
    "build:help": "npm run build:copy-help && quasar build",
    "build:copy-help": "mkdir -p dist/spa/docs && cp -r docs/help dist/spa/docs/",
    "build:pwa": "quasar build -m pwa",
    "build:electron": "quasar build -m electron",
    "build:capacitor": "quasar build -m capacitor",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint --ext .js,.ts,.vue ./src",
    "lint:fix": "eslint --ext .js,.ts,.vue ./src --fix",
    "check:i18n": "node dev-tools/check-i18n.js",
    "check:env": "node dev-tools/check-env-lanes.js",
    "postinstall": "quasar prepare",
    "check:types": "node dev-tools/check-types.js",
    "check:types:update": "node dev-tools/check-types.js --update"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.9",
    "@types/marked": "^5.0.2",
    "axios": "^1.6.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "laravel-echo": "^2.1.6",
    "marked": "^16.3.0",
    "pinia": "^2.1.0",
    "pusher-js": "^8.4.0",
    "quasar": "^2.14.0",
    "vue": "^3.4.0",
    "vue-i18n": "^12.0.0-alpha.3",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@quasar/app-vite": "^2.2.1",
    "@quasar/cli": "^2.3.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "sass": "^1.69.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^18 || ^20 || ^21 || ^22 || ^24",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
