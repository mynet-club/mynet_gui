{
  "name": "mynet-quasar",
  "version": "1.0.0",
  "description": "MyNet Quasar Application",
  "productName": "MyNet",
  "author": "MyNet Team",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:prod": "quasar build",
    "build:help": "npm run build:copy-help && quasar build",
    "build:copy-help": "mkdir -p dist/spa/docs && cp -r docs/help dist/spa/docs/",
    "build:pwa": "quasar build -m pwa",
    "build:electron": "quasar build -m electron",
    "build:capacitor": "quasar build -m capacitor",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:i18n": "node dev-tools/check-i18n.js",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@types/marked": "^5.0.2",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "laravel-echo": "^2.3.1",
    "marked": "^17.0.4",
    "pinia": "^3.0.4",
    "pusher-js": "^8.4.0",
    "quasar": "^2.18.6",
    "vue": "^3.5.30",
    "vue-i18n": "^12.0.0-alpha.3",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@quasar/app-vite": "^2.4.1",
    "@quasar/cli": "^2.5.0",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^18 || ^20 || ^21 || ^22 || ^24",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
